{
  "name": "specsync",
  "displayName": "SpecSync",
  "description": "Inline specification annotations, suggestion panel, and Lean proof runner reading from .specsync/",
  "version": "1.0.0",
  "publisher": "specsync",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onView:specsync.suggestions",
    "onCommand:specsync.showSpec",
    "onCommand:specsync.editSpec",
    "onCommand:specsync.runProof",
    "onCommand:specsync.cancelProof",
    "onCommand:specsync.refreshSpecs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "specsync.showSpec",
        "title": "Show Specification",
        "category": "SpecSync"
      },
      {
        "command": "specsync.editSpec",
        "title": "Edit Specification",
        "category": "SpecSync"
      },
      {
        "command": "specsync.runProof",
        "title": "Run Lean Proof",
        "category": "SpecSync"
      },
      {
        "command": "specsync.cancelProof",
        "title": "Cancel Lean Proof",
        "category": "SpecSync"
      },
      {
        "command": "specsync.addSuggestion",
        "title": "Add Spec Suggestion",
        "category": "SpecSync"
      },
      {
        "command": "specsync.refreshSpecs",
        "title": "Refresh Specs from .specsync/",
        "category": "SpecSync"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specsync",
          "title": "SpecSync",
          "icon": "resources/specsync.svg"
        }
      ]
    },
    "views": {
      "specsync": [
        {
          "id": "specsync.suggestions",
          "name": "Suggestions"
        }
      ]
    },
    "configuration": {
      "title": "SpecSync",
      "properties": {
        "specsync.specsDir": {
          "type": "string",
          "default": ".specsync/specs",
          "description": "Directory of accepted spec JSON files (relative to workspace root)"
        },
        "specsync.leanPath": {
          "type": "string",
          "default": "lean",
          "description": "Path to the Lean executable"
        },
        "specsync.confidenceThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence (0–1) for displaying CodeLens/hover specs"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.136.0",
    "typescript": "^5.7.2"
  }
}
